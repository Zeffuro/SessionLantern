{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session Lantern",
  "version": "0.2.1",
  "identifier": "eu.sessionlantern.companion",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": ["control"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "shortDescription": "Local session export companion",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
