{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "control",
  "description": "Only the bundled control window can manage session exports.",
  "local": true,
  "windows": ["main"],
  "permissions": ["allow-open-login", "allow-check-session", "allow-export-session", "allow-clear-session", "allow-check-updates", "allow-open-releases", "core:app:allow-version", "clipboard-manager:allow-write-secret"]
}
